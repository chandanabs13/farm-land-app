# ─── Supabase (get these from supabase.com → Project Settings → API) ─────────
# Project URL only — do NOT add /rest/v1/ at the end
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── Admin login ─────────────────────────────────────────────────────────────
ADMIN_PASSWORD=your-admin-password
ADMIN_SECRET=your-random-secret-string

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3001

# ─── Admin browser push (Zomato-style order alerts) ──────────────────────────
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ─── AI customer support chat (Gemini) ───────────────────────────────────────
# Get from: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional — defaults to gemini-flash-latest. The selected model must support
# Gemini function calling because the chat uses live catalog tools.
# GEMINI_MODEL=gemini-3.1-flash-lite
